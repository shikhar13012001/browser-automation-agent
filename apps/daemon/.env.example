CLOUD_API_URL=https://your-deployment.example.com
DASHBOARD_SECRET=match-the-value-configured-on-the-web-app
DEVICE_ID=laptop-1

# Models, tried in order; the next one continues the same session if one fails or stalls.
INTENT_AGENT_MODEL=openai/gpt-6-luna,openai/gpt-4o-mini
OPENAI_API_KEY=sk-...            # also used by the `look` vision tool
OLLAMA_API_KEY=only-needed-if-using-an-ollama-cloud-model

# Unattended-run safety. A run is aborted only after STALL_MS with no browser activity;
# MAX_RUN_MS is a last-resort cap for a single run (long applications are fine below it).
# INTENT_AGENT_STALL_MS=180000
# INTENT_AGENT_MAX_RUN_MS=1500000

# Tasks run at once, each in its own tab of the same Chrome (they share its logins).
# INTENT_AGENT_CONCURRENCY=3
# OpenAI models run in the daemon's own model loop (faster, live steps). Set this to send every
# model through OpenCode instead.
# INTENT_AGENT_ENGINE=opencode

# If the debug Chrome is closed or crashes, the daemon restarts it with this profile before the
# next task (your everyday Chrome is untouched). Unset = don't auto-start, just wait.
INTENT_AGENT_CHROME_PROFILE=D:\claude-work\chrome-debug-profile
# INTENT_AGENT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# INTENT_AGENT_CHROME_AUTOSTART=0

# Email when a task needs you, fails, or the browser is unavailable (Gmail: use an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
NOTIFY_EMAIL=you@gmail.com

# INTENT_AGENT_PROJECT_DIR is only needed to point the agent at a different repo checkout --
# it defaults to this repo's own root, resolved from this file's location, not from whatever
# directory happened to launch the process (npm workspace scripts set cwd to apps/daemon, not
# the repo root, which used to silently break context loading).
